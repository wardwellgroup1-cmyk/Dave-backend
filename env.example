# ---- Anthropic (Claude API) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ---- Vim Canvas (from your Vim Console application manifest) ----
VIM_CLIENT_ID=your-client-id
VIM_CLIENT_SECRET=your-client-secret
VIM_REDIRECT_URI=https://your-app-frontend.example.com
# Verify against the implementation guide in your Vim Console:
VIM_AUTHORIZE_URL=https://api.getvim.com/v1/oauth/authorize
VIM_TOKEN_URL=https://api.getvim.com/v1/oauth/token

# ---- CORS: your frontend origin(s), comma separated ----
ALLOWED_ORIGINS=https://your-app-frontend.example.com,http://localhost:3000
